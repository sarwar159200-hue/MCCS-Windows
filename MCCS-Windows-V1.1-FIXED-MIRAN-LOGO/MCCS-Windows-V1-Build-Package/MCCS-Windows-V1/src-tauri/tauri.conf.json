{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCCS - Miran Commercial Control System",
  "version": "1.1.0",
  "identifier": "com.miranenergy.mccs",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Miran Energy Ltd",
    "shortDescription": "Miran Commercial Control System",
    "longDescription": "MCCS desktop client for Miran Energy Ltd.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}